# ─────────────────────────────────────────────────────────────
#  Spillguard — environment template
#  Copy to `.env` and fill in. NEVER commit the real `.env`.
# ─────────────────────────────────────────────────────────────

# App
APP_ENV=dev                      # dev | prod
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR

# ── Model backend selection ──────────────────────────────────
# mock         → canned outputs, no GPU/network (tests, offline dev)
# fireworks    → real Gemma via Fireworks API (pre-GPU "real brain")
# vllm-local   → self-hosted Gemma on the AMD MI300X (the real product)
MODEL_BACKEND=mock

MODEL_NAME=google/gemma-3-12b-it

# For vllm-local: the internal address of the Gemma container.
# For fireworks: leave blank (client uses the Fireworks base URL).
MODEL_URL=http://gemma-vllm:8000/v1

# ── Credentials (only what the chosen backend needs) ─────────
FIREWORKS_API_KEY=
HF_TOKEN=                         # required to pull the gated Gemma weights

# ── Tuning ───────────────────────────────────────────────────
REQUEST_TIMEOUT_S=45
MAX_INPUT_CHARS=50000
AUDIT_DB_PATH=data/audit.db

# CORS (comma-separated). In prod the UI is same-origin, so this can be empty.
CORS_ORIGINS=http://localhost:5173
